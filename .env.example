# =============================================================================
# 瑶医分布地图 - 生产环境配置模板
# =============================================================================
# 复制为 .env.production 并填入实际值（请勿提交真实密钥到版本控制）
# 使用：docker compose --env-file .env.production up -d
# =============================================================================

# --- 应用元信息 ---
APP_VERSION=1.0.0
VITE_BUILD_TIME=
TZ=Asia/Shanghai

# --- 监听端口（宿主机映射到容器 80） ---
APP_PORT=80

# --- 错误监控（可选：Sentry / 自建日志服务 / GA4） ---
# 设置后会通过 navigator.sendBeacon 上报：
# - window.onerror 捕获的 JS 异常
# - unhandledrejection 捕获的 Promise 拒绝
# - PerformanceObserver 抓取的 navigation timing
VITE_MONITOR_ENDPOINT=
VITE_MONITOR_SAMPLE=1.0

# --- 远程配置（可选：从远程端点注入运行时配置） ---
# 注意：注入的内容必须可执行 JSON.parse；URL 应该是同源或允许 CORS 的端点
VITE_REMOTE_CONFIG_URL=

# --- API 后端（可选：本项目当前为纯前端，预留扩展） ---
# 例如：VITE_API_BASE_URL=https://api.yaoyi.com
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=8000

# --- 日志级别（仅影响 src/lib/monitoring.ts 控制台输出） ---
# 开发：debug / info，生产：warn / error
LOG_LEVEL=warn

# --- 镜像仓库（CI/CD 推送时使用） ---
DOCKER_REGISTRY=
DOCKER_IMAGE=yaoyi-map
DOCKER_TAG=1.0.0

# --- Nginx 服务域名（仅用于 metrics 标签，非必需） ---
PUBLIC_HOSTNAME=yaoyi-map.local

# =============================================================================
# 安全提醒
# =============================================================================
# 1. 生产环境务必启用 HTTPS：在 cloud-provider 启用 TLS termination
# 2. CSP 白名单：若使用了第三方图片/字体，调整 docker/conf.d/yaoyi.conf
# 3. VITE_MONITOR_ENDPOINT 应指向 https://（sendBeacon 不允许 http 跨域）
# 4. 上传 .env.production 到 GitHub Secrets 而非仓库
# =============================================================================