{
  "name": "yaoyi-map",
  "private": true,
  "version": "1.0.0",
  "description": "瑶医分布交互式地图：探索瑶族传统医学与草药资源的可视化平台",
  "type": "module",
  "engines": {
    "node": ">=18.0.0 <21.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:no-typecheck": "vite build",
    "preview": "vite preview --port 4173",
    "check": "tsc -b --noEmit",
    "lint": "eslint .",
    "serve": "node server.cjs",
    "serve:prod": "cross-env NODE_ENV=production node server.cjs",
    "start": "node server.cjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:audit": "node scripts/runtime-audit.mjs",
    "test:interaction": "node scripts/interaction-audit.mjs",
    "test:server": "node test-server-regression.mjs",
    "test:ui": "node scripts/ui-presentation-test.mjs",
    "test:drilldown": "node test-hainan-drilldown.mjs",
    "test:hainan": "node test-hainan-browser.mjs",
    "docker:build": "docker build -t yaoyi-map:1.0.0 .",
    "docker:run": "docker run -d -p 5187:5187 --name yaoyi-map --restart unless-stopped yaoyi-map:1.0.0",
    "docker:stop": "docker stop yaoyi-map && docker rm yaoyi-map",
    "deploy:vercel": "vercel --prod",
    "clean": "rimraf dist .vite"
  },
  "dependencies": {
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "china-map-echarts": "^1.0.5",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "echarts-gl": "^2.1.0",
    "framer-motion": "^12.42.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
